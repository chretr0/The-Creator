# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local credentials: only deliberately named example templates may be committed.
.env
.env.*
!.env.example
!.env.*.example
.netrc
_netrc
.cdsapirc
.adsapirc
.ecmwfapirc
.urs_cookies
.aws/
.ssh/
*.key
*.pem
*.p12
*.pfx

# Local databases, backups and logs (db/migrations/*.sql stays tracked).
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.gz
*.sql.bz2
*.log
gitleaks-report*.json

# Node
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

.DS_Store

# Downloaded datasets (large; provenance lives in data/raw/*/source.json)
data/raw/**
!data/raw/**/
!data/raw/**/source.json

# Global H3 layers (~1.3 GB, regenerated by scripts/ — see data/STATUS.md)
data/prepared/*_h3r6.parquet
# Moon H3 layers (regenerated by scripts/moon/prepare_moon_*.py); layers.json stays committed
data/prepared/moon/h3/*.parquet

# Larger prepared record layers and scene PNGs (rebuilt by scripts/prepare_feature_layers.py and
# scripts/prepare_imagery.py); the small layers and every manifest stay committed.
data/prepared/features/mrds.parquet
data/prepared/features/hydrorivers.geojson
data/prepared/infrastructure/power_plants.geojson
data/prepared/infrastructure/transmission_lines.geojson
data/prepared/imagery/*.png

# Live-source response cache (rebuilt automatically)
data/cache/
data/*.log
