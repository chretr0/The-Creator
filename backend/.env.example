# Copy to backend/.env for local overrides; never commit the populated .env.
# These are disposable local-development database credentials, not production secrets.
NEWWORLDS_DATABASE_URL=postgresql://newworlds:newworlds@localhost:5433/newworlds
NEWWORLDS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional NASA FIRMS key. Leave unset to keep live fires disabled.
# Request your own at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# NEWWORLDS_FIRMS_MAP_KEY=
